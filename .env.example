# LinkedIn Voyager API credentials
# Generate cookies.json by running: python scripts/get_cookies.py
# (or point to an existing cookies file)
COOKIES_PATH=cookies.json

# Alternative to COOKIES_PATH: paste the raw cookies.json contents here instead
# (useful on Render/Heroku, which have no persistent filesystem). Takes precedence.
# COOKIES_JSON=

# --- Search settings ---
# Comma-separated keywords (JSON list also supported)
KEYWORDS=["Data Analyst","Data Analytics","Data Scientist","Business Analyst"]

# LinkedIn geoId (102713980 = India, 103644278 = United States)
GEO_ID=102713980

# Time posted range: r86400 (24h), r604800 (week), r2592000 (month), or any r<seconds>
TIME_POSTED_RANGE=r86400

# Sort: DD = date descending (newest first)
SORT_BY=DD

# Number of results per page (max 25)
COUNT=25

# Client-side "latest only" filter (optional): keep only jobs listed within N minutes.
# Leave unset (or commented out) to rely only on TIME_POSTED_RANGE.
# MAX_AGE_MINUTES=60

# Experience level filter (API-level). "1"=Internship, "2"=Entry level. Empty disables.
EXPERIENCE_LEVELS=["1","2"]

# Client-side title filter: keep a job only if its title contains ANY of these
# substrings (case-insensitive). Empty list [] disables the filter.
TITLE_KEYWORDS=["analyst","analytics","data science","data scientist"]

# --- Polling ---
POLL_INTERVAL_SECONDS=300

# Companies to skip (JSON list). Overrides the defaults in app/config.py.
BLACKLISTED_COMPANIES=["Skillzenloop","Zenithbyte","Wake Up Whistle","F6IT Fintech & IT Solutions","internmo","Dexter's Tech","ArGo Intern"]

# --- Storage ---
SENT_JOBS_FILE=sent_jobs.json
DEDUP_RETENTION_DAYS=7

# --- Email notifications (Gmail API via OAuth) ---
# Get these by running: python scripts/get_gmail_token.py client_secret.json
SENDER_EMAIL=
RECEIVER_EMAIL=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
